{
  "name": "dragonconnector",
  "version": "1.0.0",
  "private": true,
  "description": "Dragon Connector: an installable, gamified participant app for a proposed Solana Mobile and AI hackathon in Da Nang.",
  "license": "MIT",
  "homepage": "https://dragonconnectorapp.vercel.app",
  "repository": { "type": "git", "url": "git+https://github.com/operatoruplift/dragonconnector.git" },
  "type": "module",
  "scripts": {
    "start": "python3 -m http.server 8428 --bind 127.0.0.1 --directory public",
    "test": "node --test tests/*.test.mjs",
    "precache": "node scripts/build-precache.mjs",
    "assets": "node scripts/render-assets.cjs && node scripts/build-precache.mjs"
  },
  "engines": { "node": ">=20" }
}
